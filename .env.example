# Core
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Database
POSTGRES_DSN=postgresql+psycopg2://postgres:postgres@db:5432/ai_superbot
POSTGRES_DB=ai_superbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:replace_me
WEBHOOK_URL=
WEBHOOK_SECRET_PATH=/superhook-12345
BOT_NAME=FacelabXbot
ADMIN_IDS=123456789
ADMIN_CHAT_ID=123456789

# Features
ONBOARDING_PREMIUM_QUERIES=15
FREE_IMAGE_CREDITS=2
FREE_VIDEO_SECONDS=20

# Security / API exposure
ALLOWED_ORIGINS=https://example.com
ALLOWED_HOSTS=example.com,localhost,127.0.0.1,api
FORCE_HTTPS_REDIRECT=true
HMAC_SIGNING_KEY=replace_me
INTERNAL_API_TOKEN=replace_me
API_EXPOSE_DOCS=false

# Public URLs
API_PUBLIC_URL=https://example.com
PAYMENTS_PUBLIC_URL=https://example.com

# Approximate costs for non-tokenized flows
ESTIMATED_COST_IMAGE_STD_USD=0.02
ESTIMATED_COST_IMAGE_PRO_USD=0.06
ESTIMATED_COST_MESSAGE_USD=0.001
ESTIMATED_COST_VIDEO_SECOND_USD=0.01

# Gemini / NanoBanana
GEMINI_API_KEY=replace_me
NANOBANANA_ENABLED=true
GEMINI_CONTEXT_MESSAGES=4
GEMINI_TEMPERATURE=0.1
NANOBANANA_MODEL_CHAT=gemini-2.5-pro
NANOBANANA_MODEL_CHAT_FALLBACK=gemini-2.5-flash
NANOBANANA_MODEL_IMAGE=gemini-3-pro-image-preview
NANOBANANA_MODEL_IMAGE_PRO2=gemini-3.1-flash-image-preview
NANOBANANA_MODEL_IMAGE_FALLBACK=gemini-2.5-flash-image

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID=replace_me
CLOUDPAYMENTS_API_SECRET=replace_me
